# Test-only PostgreSQL server connection. The role must be allowed to CREATE
# and DROP databases. Tests create a uniquely named disposable database per
# run and never read or write the database named in this URL.
#
# Optional: when TEST_DATABASE_URL is absent, the test harness falls back to
# DATABASE_URL from .env for server credentials. The disposable database is
# still isolated; only the server connection is shared.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/postgres"
