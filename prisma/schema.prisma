// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HistoryRecordType {
  STAFF_USER
  EDUCATIONAL_INSTITUTION
  FACULTY
  DEPARTMENT
  STUDENT
  STUDENT_QUALIFICATION
  DOCUMENT
  SUPERVISOR

  @@map("history_record_type")
}

enum HistoryAction {
  ACCOUNT_PROVISIONED
  PASSWORD_RESET
  ACCOUNT_DEACTIVATED
  SIGN_IN
  SIGN_IN_FAILED
  PASSWORD_CHANGED
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  RESTORED
  DEACTIVATED

  @@map("history_action")
}

enum HistoryActorKind {
  STAFF
  OPERATOR
  UNAUTHENTICATED

  @@map("history_actor_kind")
}

enum InstitutionType {
  PUBLIC_UNIVERSITY
  PRIVATE_UNIVERSITY
  NATIONAL_UNIVERSITY
  PRIVATE_INSTITUTE
  PUBLIC_INSTITUTE
  FOREIGN_INSTITUTION
  OTHER

  @@map("institution_type")
}

enum MilitaryStatus {
  COMPLETED
  EXEMPTED
  POSTPONED

  @@map("military_status")
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  PROFESSIONAL

  @@map("degree_level")
}

enum EquivalencyStatus {
  NOT_ASSESSED
  NOT_REQUIRED
  REQUIRED
  PENDING
  APPROVED
  REJECTED

  @@map("equivalency_status")
}

enum DocumentType {
  NATIONAL_ID
  BIRTH_CERTIFICATE
  BACHELOR_CERTIFICATE
  MASTER_CERTIFICATE
  PHD_CERTIFICATE
  PROFESSIONAL_CERTIFICATE
  TRANSCRIPT
  MILITARY_CERTIFICATE
  PERSONAL_PHOTO
  EQUIVALENCY_DECISION
  NON_ENROLLMENT_DECLARATION
  OTHER
  SUPERVISOR_SUPPORTING_DOCUMENT

  @@map("document_type")
}

enum AcademicRank {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  LECTURER
  ASSOCIATE_LECTURER

  @@map("academic_rank")
}

enum SupervisorAffiliation {
  INTERNAL
  EXTERNAL

  @@map("supervisor_affiliation")
}

enum ExternalApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("external_approval_status")
}

enum DocumentAvailability {
  AVAILABLE
  DELETE_PENDING
  DELETED

  @@map("document_availability")
}

enum FileOperationKind {
  UPLOAD
  DELETE

  @@map("file_operation_kind")
}

enum FileOperationStatus {
  IN_PROGRESS
  CLEANUP_PENDING
  COMPLETED
  FAILED

  @@map("file_operation_status")
}

model StaffUser {
  id               Int             @id @default(autoincrement())
  username         String          @unique @db.VarChar(100)
  fullName         String          @map("full_name") @db.VarChar(200)
  passwordHash     String          @map("password_hash")
  deactivatedAt    DateTime?       @map("deactivated_at") @db.Timestamptz(3)
  authVersion      Int             @default(1) @map("auth_version")
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         StaffSession[]
  history          ChangeHistory[]
  deletedDocuments Document[]      @relation("DeletedDocuments")
  fileOperations   FileOperation[] @relation("RequestedFileOperations")

  @@map("staff_user")
}

model StaffSession {
  id                Int       @id @default(autoincrement())
  staffUserId       Int       @map("staff_user_id")
  credentialDigest  String    @unique @map("credential_digest") @db.Char(64)
  authVersion       Int       @map("auth_version")
  csrfSecret        String    @map("csrf_secret")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  staffUser         StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId])
  @@index([lastSeenAt])
  @@index([absoluteExpiresAt])
  @@map("staff_session")
}

model ChangeHistory {
  id                   Int               @id @default(autoincrement())
  recordType           HistoryRecordType @map("record_type")
  recordId             Int?              @map("record_id")
  action               HistoryAction
  actorKind            HistoryActorKind  @map("actor_kind")
  staffUserId          Int?              @map("staff_user_id")
  operatorAttribution  String?           @map("operator_attribution") @db.VarChar(200)
  occurredAt           DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  before               Json?
  after                Json?
  operationCorrelation String?           @unique @map("operation_correlation") @db.VarChar(200)
  staffUser            StaffUser?        @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recordType, recordId, occurredAt, id])
  @@index([staffUserId])
  @@map("change_history")
}

model EducationalInstitution {
  id              Int                    @id @default(autoincrement())
  name            String                 @db.VarChar(200)
  institutionType InstitutionType        @map("institution_type")
  version         Int                    @default(1)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  faculties       Faculty[]
  qualifications  StudentQualification[]

  @@index([institutionType])
  @@index([name])
  @@map("educational_institution")
}

model Faculty {
  id             Int                    @id @default(autoincrement())
  institutionId  Int                    @map("institution_id")
  name           String                 @db.VarChar(200)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution    EducationalInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departments    Department[]
  qualifications StudentQualification[]

  @@unique([id, institutionId])
  @@unique([institutionId, name])
  @@index([name])
  @@map("faculty")
}

model Department {
  id             Int                    @id @default(autoincrement())
  facultyId      Int                    @map("faculty_id")
  name           String                 @db.VarChar(200)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  faculty        Faculty                @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qualifications StudentQualification[]
  supervisors    Supervisor[]

  @@unique([id, facultyId])
  @@unique([facultyId, name])
  @@index([name])
  @@map("department")
}

model Supervisor {
  id                      Int                     @id @default(autoincrement())
  fullName                String                  @map("full_name") @db.VarChar(200)
  academicRank            AcademicRank            @map("academic_rank")
  affiliation             SupervisorAffiliation
  departmentId            Int?                    @map("department_id")
  workplace               String?                 @db.VarChar(200)
  phone                   String?                 @db.VarChar(50)
  email                   String?                 @db.VarChar(254)
  nationalId              String?                 @map("national_id") @db.VarChar(50)
  externalApprovalStatus  ExternalApprovalStatus? @map("external_approval_status")
  externalRejectionReason String?                 @map("external_rejection_reason") @db.VarChar(500)
  deactivatedAt           DateTime?               @map("deactivated_at") @db.Timestamptz(3)
  version                 Int                     @default(1)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  department              Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documents               Document[]              @relation("SupervisorDocuments")
  fileOperations          FileOperation[]

  @@index([deactivatedAt, id])
  @@index([fullName])
  @@index([nationalId])
  @@index([departmentId])
  @@index([affiliation, externalApprovalStatus])
  @@map("supervisor")
}

model Student {
  id                      Int                    @id @default(autoincrement())
  fullName                String                 @map("full_name") @db.VarChar(200)
  nationalId              String                 @unique @map("national_id") @db.VarChar(14)
  phone                   String?                @db.VarChar(50)
  birthDate               DateTime?              @map("birth_date") @db.Date
  address                 String?                @db.VarChar(500)
  militaryStatus          MilitaryStatus?        @map("military_status")
  selectedPhotoDocumentId Int?                   @map("selected_photo_document_id")
  archivedAt              DateTime?              @map("archived_at") @db.Timestamptz(3)
  version                 Int                    @default(1)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  qualifications          StudentQualification[]
  documents               Document[]             @relation("StudentDocuments")
  selectedPhotoDocument   Document?              @relation("StudentSelectedPhoto", fields: [selectedPhotoDocumentId, id], references: [id, studentId], onDelete: Restrict, onUpdate: Restrict)
  fileOperations          FileOperation[]

  @@index([archivedAt, id])
  @@index([fullName])
  @@index([selectedPhotoDocumentId])
  @@map("student")
}

model StudentQualification {
  id                        Int                     @id @default(autoincrement())
  studentId                 Int                     @map("student_id")
  degreeLevel               DegreeLevel             @map("degree_level")
  qualificationName         String?                 @map("qualification_name") @db.VarChar(200)
  institutionId             Int?                    @map("institution_id")
  facultyId                 Int?                    @map("faculty_id")
  departmentId              Int?                    @map("department_id")
  graduationYear            Int?                    @map("graduation_year")
  overallGrade              String?                 @map("overall_grade") @db.VarChar(100)
  equivalencyStatus         EquivalencyStatus       @default(NOT_ASSESSED) @map("equivalency_status")
  equivalencyDecisionNumber String?                 @map("equivalency_decision_number") @db.VarChar(100)
  equivalencyDecisionDate   DateTime?               @map("equivalency_decision_date") @db.Date
  archivedAt                DateTime?               @map("archived_at") @db.Timestamptz(3)
  version                   Int                     @default(1)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  student                   Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  institution               EducationalInstitution? @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  faculty                   Faculty?                @relation(fields: [facultyId, institutionId], references: [id, institutionId], onDelete: Restrict, onUpdate: Restrict)
  department                Department?             @relation(fields: [departmentId, facultyId], references: [id, facultyId], onDelete: Restrict, onUpdate: Restrict)
  documents                 Document[]

  @@unique([id, studentId])
  @@index([studentId, archivedAt, id])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@map("student_qualification")
}

model Document {
  id                   Int                   @id @default(autoincrement())
  studentId            Int?                  @map("student_id")
  supervisorId         Int?                  @map("supervisor_id")
  qualificationId      Int?                  @map("qualification_id")
  documentType         DocumentType          @map("document_type")
  description          String?               @db.VarChar(500)
  originalFileName     String                @map("original_file_name") @db.VarChar(255)
  storageKey           String                @unique @map("storage_key") @db.VarChar(64)
  mimeType             String                @map("mime_type") @db.VarChar(128)
  byteSize             Int                   @map("byte_size")
  uploadedAt           DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  archivedAt           DateTime?             @map("archived_at") @db.Timestamptz(3)
  availability         DocumentAvailability  @default(AVAILABLE)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(3)
  deletedByStaffUserId Int?                  @map("deleted_by_staff_user_id")
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  student              Student?              @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supervisor           Supervisor?           @relation("SupervisorDocuments", fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qualification        StudentQualification? @relation(fields: [qualificationId, studentId], references: [id, studentId], onDelete: Restrict, onUpdate: Restrict)
  deletedByStaffUser   StaffUser?            @relation("DeletedDocuments", fields: [deletedByStaffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedByStudents   Student[]             @relation("StudentSelectedPhoto")
  fileOperations       FileOperation[]

  @@unique([id, studentId])
  @@index([studentId, archivedAt, availability, id])
  @@index([supervisorId, archivedAt, availability, id])
  @@index([qualificationId])
  @@index([deletedByStaffUserId])
  @@map("document")
}

model FileOperation {
  id                     Int                 @id @default(autoincrement())
  kind                   FileOperationKind
  status                 FileOperationStatus @default(IN_PROGRESS)
  requestedByStaffUserId Int                 @map("requested_by_staff_user_id")
  studentId              Int?                @map("student_id")
  supervisorId           Int?                @map("supervisor_id")
  documentId             Int?                @map("document_id")
  idempotencyKey         String              @map("idempotency_key") @db.VarChar(128)
  requestFingerprint     String?             @map("request_fingerprint") @db.Char(64)
  stagingKey             String?             @unique @map("staging_key") @db.VarChar(64)
  storageKey             String              @map("storage_key") @db.VarChar(64)
  executorId             String?             @map("executor_id") @db.VarChar(64)
  claimToken             String?             @map("claim_token") @db.VarChar(64)
  leaseExpiresAt         DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  errorStatus            Int?                @map("error_status")
  errorCode              String?             @map("error_code") @db.VarChar(100)
  errorMessage           String?             @map("error_message") @db.VarChar(300)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt            DateTime?           @map("completed_at") @db.Timestamptz(3)
  requestedByStaffUser   StaffUser           @relation("RequestedFileOperations", fields: [requestedByStaffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student                Student?            @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supervisor             Supervisor?         @relation(fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document               Document?           @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestedByStaffUserId, kind, idempotencyKey])
  @@index([status, leaseExpiresAt, id])
  @@index([studentId])
  @@index([supervisorId])
  @@index([documentId])
  @@map("file_operation")
}
