// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HistoryRecordType {
  STAFF_USER
  EDUCATIONAL_INSTITUTION
  FACULTY
  DEPARTMENT
  STUDENT

  @@map("history_record_type")
}

enum HistoryAction {
  ACCOUNT_PROVISIONED
  PASSWORD_RESET
  ACCOUNT_DEACTIVATED
  SIGN_IN
  SIGN_IN_FAILED
  PASSWORD_CHANGED
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  RESTORED

  @@map("history_action")
}

enum HistoryActorKind {
  STAFF
  OPERATOR
  UNAUTHENTICATED

  @@map("history_actor_kind")
}

enum InstitutionType {
  PUBLIC_UNIVERSITY
  PRIVATE_UNIVERSITY
  NATIONAL_UNIVERSITY
  PRIVATE_INSTITUTE
  PUBLIC_INSTITUTE
  FOREIGN_INSTITUTION
  OTHER

  @@map("institution_type")
}

enum MilitaryStatus {
  COMPLETED
  EXEMPTED
  POSTPONED

  @@map("military_status")
}

model StaffUser {
  id            Int             @id @default(autoincrement())
  username      String          @unique @db.VarChar(100)
  fullName      String          @map("full_name") @db.VarChar(200)
  passwordHash  String          @map("password_hash")
  deactivatedAt DateTime?       @map("deactivated_at") @db.Timestamptz(3)
  authVersion   Int             @default(1) @map("auth_version")
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      StaffSession[]
  history       ChangeHistory[]

  @@map("staff_user")
}

model StaffSession {
  id                Int       @id @default(autoincrement())
  staffUserId       Int       @map("staff_user_id")
  credentialDigest  String    @unique @map("credential_digest") @db.Char(64)
  authVersion       Int       @map("auth_version")
  csrfSecret        String    @map("csrf_secret")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  staffUser         StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId])
  @@index([lastSeenAt])
  @@index([absoluteExpiresAt])
  @@map("staff_session")
}

model ChangeHistory {
  id                   Int               @id @default(autoincrement())
  recordType           HistoryRecordType @map("record_type")
  recordId             Int?              @map("record_id")
  action               HistoryAction
  actorKind            HistoryActorKind  @map("actor_kind")
  staffUserId          Int?              @map("staff_user_id")
  operatorAttribution  String?           @map("operator_attribution") @db.VarChar(200)
  occurredAt           DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  before               Json?
  after                Json?
  operationCorrelation String?           @unique @map("operation_correlation") @db.VarChar(200)
  staffUser            StaffUser?        @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recordType, recordId, occurredAt, id])
  @@index([staffUserId])
  @@map("change_history")
}

model EducationalInstitution {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(200)
  institutionType InstitutionType @map("institution_type")
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  faculties       Faculty[]

  @@index([institutionType])
  @@index([name])
  @@map("educational_institution")
}

model Faculty {
  id            Int                    @id @default(autoincrement())
  institutionId Int                    @map("institution_id")
  name          String                 @db.VarChar(200)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution   EducationalInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departments   Department[]

  @@unique([institutionId, name])
  @@index([name])
  @@map("faculty")
}

model Department {
  id        Int      @id @default(autoincrement())
  facultyId Int      @map("faculty_id")
  name      String   @db.VarChar(200)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([facultyId, name])
  @@index([name])
  @@map("department")
}

model Student {
  id                      Int             @id @default(autoincrement())
  fullName                String          @map("full_name") @db.VarChar(200)
  nationalId              String          @unique @map("national_id") @db.VarChar(14)
  phone                   String?         @db.VarChar(50)
  birthDate               DateTime?       @map("birth_date") @db.Date
  address                 String?         @db.VarChar(500)
  militaryStatus          MilitaryStatus? @map("military_status")
  selectedPhotoDocumentId Int?            @map("selected_photo_document_id")
  archivedAt              DateTime?       @map("archived_at") @db.Timestamptz(3)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([archivedAt, id])
  @@index([fullName])
  @@map("student")
}
