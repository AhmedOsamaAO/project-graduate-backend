# Runtime mode: development, test, or production. The npm start scripts default
# this when it is unset; set it explicitly when launching the built entry point.
NODE_ENV="development"

# Non-owner runtime LOGIN, member only of graduate_runtime. Used by the app
# and staff commands. Startup refuses roles able to rewrite history.
DATABASE_URL="postgresql://RUNTIME_USER:RUNTIME_PASSWORD@localhost:5432/DATABASE?schema=public"

# Operator-only owner connection used by prisma7.config.ts for migrations.
# Requires CREATEROLE for initial setup. NEVER give this to the running service.
# Prefer supplying it only in the operator's migration environment.
MIGRATION_DATABASE_URL="postgresql://MIGRATION_OWNER:OWNER_PASSWORD@localhost:5432/DATABASE?schema=public"

# HTTP listener. Production must bind loopback (127.0.0.1 or ::1) behind the
# TLS reverse proxy.
PORT="3000"
HOST="127.0.0.1"

# Exact frontend origins allowed to make credentialed requests. Comma-separate
# multiple origins. Entries must have no path, credentials, query, or fragment.
# Production origins must use https.
FRONTEND_ORIGINS="http://localhost:5173"

# Cookie and CSRF policy. Production requires secure cookies and synchronizer
# CSRF protection.
COOKIE_SECURE="false"
CSRF_MODE="synchronizer"

# Session expiry defaults: 2 hours idle, 7-day absolute maximum, and 15-minute cleanup sweep.
SESSION_IDLE_TIMEOUT_MINUTES="120"
SESSION_ABSOLUTE_TIMEOUT_DAYS="7"
SESSION_CLEANUP_INTERVAL_MINUTES="15"

# Absolute path to the private document storage root. Production requires this
# to be set explicitly. Development may use the default storage/ directory
# beside the project; tests always use a disposable temporary directory.
PRIVATE_STORAGE_ROOT="/absolute/path/to/private-storage"

# Maximum accepted upload size in bytes. 10485760 is 10 MiB.
UPLOAD_MAX_BYTES="10485760"

# Durable file-operation executor lease and periodic reconciliation interval in seconds.
FILE_OPERATION_RECONCILIATION_INTERVAL_SECONDS="60"
FILE_OPERATION_LEASE_SECONDS="120"
