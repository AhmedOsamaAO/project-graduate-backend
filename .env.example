# Runtime mode: development, test, or production. The npm start scripts set
# this automatically; set it explicitly when launching the built entry point.
NODE_ENV="development"

# Postgres connection string used by Prisma (prisma7.config.ts) and by the
# PrismaPg adapter at runtime (src/prisma/prisma.service.ts).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# HTTP listener. Production must bind loopback (127.0.0.1 or ::1) behind the
# TLS reverse proxy.
PORT="3000"
HOST="127.0.0.1"

# Exact frontend origins allowed to make credentialed requests. Comma-separate
# multiple origins. Entries must have no path, credentials, query, or fragment.
# Production origins must use https.
FRONTEND_ORIGINS="http://localhost:5173"

# Cookie and CSRF policy. Production requires secure cookies and synchronizer
# CSRF protection.
COOKIE_SECURE="false"
CSRF_MODE="synchronizer"

# Session expiry defaults: 2 hours idle and a 7-day absolute maximum.
SESSION_IDLE_TIMEOUT_MINUTES="120"
SESSION_ABSOLUTE_TIMEOUT_DAYS="7"

# Absolute path to the private document storage root. Production requires this
# to be set explicitly; development and tests may use the default storage/
# directory beside the project.
PRIVATE_STORAGE_ROOT="/absolute/path/to/private-storage"

# Maximum accepted upload size in bytes. 10485760 is 10 MiB.
UPLOAD_MAX_BYTES="10485760"
